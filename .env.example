# =============================================================================
# PGS (Portal Guna Sekolah) — contoh environment variables
# Salin ke .env.local lalu isi:  cp .env.example .env.local
# JANGAN commit .env.local. Minta nilai asli ke pemilik project (nilai produksi
# tersimpan di Vercel project `pgs` → Settings → Environment Variables).
# Tanda [WAJIB] = app tidak jalan tanpa ini; [OPSIONAL] = fitur terkait mati/degradasi.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL (Drizzle ORM)
# -----------------------------------------------------------------------------
# [WAJIB] Pakai TRANSACTION pooler Supabase (port 6543), bukan session pooler (5432).
# Supabase Dashboard → Project Settings → Database → Connection string → Transaction pooler.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# [OPSIONAL] Maks koneksi pool per instance. Default: 10 di dev, 2 di production.
# DB_POOL_MAX=10

# [OPSIONAL] Supabase project URL & service role key (Dashboard → Project Settings → API).
# Saat ini tidak dipakai langsung oleh kode di src/; simpan untuk skrip/admin.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Autentikasi — Auth.js (NextAuth v5)
# -----------------------------------------------------------------------------
# [WAJIB] Secret untuk enkripsi session/JWT. Generate: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Nama lama, tetap dibaca Auth.js sebagai fallback — samakan dengan AUTH_SECRET.
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# [WAJIB di luar Vercel] Percayai header host (localhost / self-host / preview).
AUTH_TRUST_HOST=true
# [OPSIONAL] URL dasar app. Di Vercel tidak perlu.
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Cache & rate limit — Upstash Redis
# -----------------------------------------------------------------------------
# [WAJIB] Upstash Console → database → REST API.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# -----------------------------------------------------------------------------
# Upload gambar — Cloudinary (unsigned upload dari browser)
# -----------------------------------------------------------------------------
# [OPSIONAL] Tanpa ini, upload foto/gambar gagal dengan pesan konfigurasi.
# Cloudinary Console → Settings → Upload → Upload presets (mode: Unsigned).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# -----------------------------------------------------------------------------
# Web Push notification — VAPID
# -----------------------------------------------------------------------------
# [OPSIONAL] Tanpa ini, push notification nonaktif (notifikasi in-app tetap jalan).
# Generate pasangan key: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# -----------------------------------------------------------------------------
# Keuangan — cron & webhook pembayaran
# -----------------------------------------------------------------------------
# [WAJIB di production] Auth untuk cron /api/cron/finance (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=generate-random-string
# [WAJIB di production] Secret signature webhook /api/payment/webhook (HMAC-SHA256).
PAYMENT_WEBHOOK_SECRET=generate-another-random-string

# [OPSIONAL] Channel reminder eksternal (tanpa ini, reminder whatsapp/email
# ditandai failed; in_app tetap berjalan).
# WHATSAPP_API_URL=https://api.whatsapp.example/v1/messages
# SMTP_HOST=smtp.example.com

# -----------------------------------------------------------------------------
# E2E testing (Playwright)
# -----------------------------------------------------------------------------
# [OPSIONAL] Akun test untuk login di e2e.
E2E_TEST_EMAIL=test@example.com
E2E_TEST_PASSWORD=testpassword
# Override baseURL jika test ke staging/production.
# E2E_BASE_URL=https://portalgunasekolah.vercel.app

# -----------------------------------------------------------------------------
# Tooling lokal (opsional)
# -----------------------------------------------------------------------------
# Lokasi output .next (mis. di disk cepat): NEXT_DIST_DIR=/path/to/.next
# NEXT_DIST_DIR=
# Path Chromium untuk scripts/lighthouse-audit.mjs
# CHROME_PATH=/usr/bin/chromium

# Catatan: VERCEL_OIDC_TOKEN otomatis dibuat oleh `vercel env pull`, tidak perlu diisi manual.
